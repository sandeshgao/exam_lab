    {
      "cell_type": "code",
      "source": [
        "#!/usr/bin/env bash\n",
        "set -euo pipefail\n",
        "\n",
        "# newcert: generate a self-signed certificate and private key using openssl\n",
        "# Usage:\n",
        "#   ./newcert \"/C=US/ST=North Carolina/L=Raleigh/O=RedHat/CN=example.com\"\n",
        "# Optional flags:\n",
        "#   -d DAYS   Validity days (default: 825)\n",
        "#   -b BITS   RSA key size (default: 2048)\n",
        "#   -o DIR    Output directory (default: ./certs)\n",
        "#   -n NAME   Base name for files (default: derived from CN)\n",
        "#   -s        Create a subjectAltName (SAN) with DNS=CN (recommended)\n",
        "#\n",
        "# Outputs:\n",
        "#   <name>.key, <name>.crt, <name>.csr (and optionally <name>.cnf)\n",
        "\n",
        "DAYS=825\n",
        "BITS=2048\n",
        "OUTDIR=\"./certs\"\n",
        "NAME=\"\"\n",
        "ADD_SAN=0\n",
        "\n",
        "usage() {\n",
        "  cat <<'EOF'\n",
        "Usage:\n",
        "  newcert [options] \"/C=US/ST=State/L=City/O=Org/OU=Unit/CN=example.com\"\n",
        "\n",
        "Options:\n",
        "  -d DAYS   Validity days (default: 825)\n",
        "  -b BITS   RSA key size (default: 2048)\n",
        "  -o DIR    Output directory (default: ./certs)\n",
        "  -n NAME   Base name for output files (default: derived from CN)\n",
        "  -s        Add subjectAltName=DNS:CN (recommended)\n",
        "  -h        Show help\n",
        "\n",
        "Example:\n",
        "  ./newcert -s \"/C=US/ST=North Carolina/L=Raleigh/O=RedHat/CN=quart.apps.ocp4.example.com\"\n",
        "EOF\n",
        "}\n",
        "\n",
        "while getopts \":d:b:o:n:sh\" opt; do\n",
        "  case \"$opt\" in\n",
        "    d) DAYS=\"$OPTARG\" ;;\n",
        "    b) BITS=\"$OPTARG\" ;;\n",
        "    o) OUTDIR=\"$OPTARG\" ;;\n",
        "    n) NAME=\"$OPTARG\" ;;\n",
        "    s) ADD_SAN=1 ;;\n",
        "    h) usage; exit 0 ;;\n",
        "    \\?) echo \"Unknown option: -$OPTARG\" >&2; usage; exit 2 ;;\n",
        "    :)  echo \"Option -$OPTARG requires an argument.\" >&2; usage; exit 2 ;;\n",
        "  esac\n",
        "done\n",
        "shift $((OPTIND - 1))\n",
        "\n",
        "SUBJECT=\"${1:-}\"\n",
        "\n",
        "# If subject not passed, prompt for it\n",
        "if [[ -z \"$SUBJECT\" ]]; then\n",
        "  echo \"Enter subject DN (example: /C=US/ST=State/L=City/O=Org/CN=example.com)\"\n",
        "  read -r SUBJECT\n",
        "fi\n",
        "\n",
        "if [[ -z \"$SUBJECT\" ]]; then\n",
        "  echo \"ERROR: Subject DN is required.\" >&2\n",
        "  exit 1\n",
        "fi\n",
        "\n",
        "# Extract CN from subject (best effort)\n",
        "CN=\"$(printf '%s' \"$SUBJECT\" | sed -n 's#.*\\/CN=\\([^/]*\\).*#\\1#p')\"\n",
        "if [[ -z \"$CN\" ]]; then\n",
        "  echo \"ERROR: Could not find CN in subject. Make sure you include /CN=...\" >&2\n",
        "  exit 1\n",
        "fi\n",
        "\n",
        "# Derive name if not provided: replace non-safe chars with underscores\n",
        "if [[ -z \"$NAME\" ]]; then\n",
        "  NAME=\"$(printf '%s' \"$CN\" | sed 's/[^A-Za-z0-9._-]/_/g')\"\n",
        "fi\n",
        "\n",
        "mkdir -p \"$OUTDIR\"\n",
        "\n",
        "KEY=\"$OUTDIR/$NAME.key\"\n",
        "CRT=\"$OUTDIR/$NAME.crt\"\n",
        "CSR=\"$OUTDIR/$NAME.csr\"\n",
        "CNF=\"$OUTDIR/$NAME.cnf\"\n",
        "\n",
        "# Build openssl arguments for SAN if requested\n",
        "if [[ \"$ADD_SAN\" -eq 1 ]]; then\n",
        "  cat > \"$CNF\" <<EOF\n",
        "[ req ]\n",
        "default_bits       = $BITS\n",
        "prompt             = no\n",
        "default_md         = sha256\n",
        "distinguished_name = dn\n",
        "req_extensions     = req_ext\n",
        "\n",
        "[ dn ]\n",
        "# Subject is still supplied on command line for simplicity; dn section not used.\n",
        "# This file mainly provides SAN.\n",
        "\n",
        "[ req_ext ]\n",
        "subjectAltName = @alt_names\n",
        "\n",
        "[ alt_names ]\n",
        "DNS.1 = $CN\n",
        "EOF\n",
        "\n",
        "  # Generate key + cert (self-signed) with SAN\n",
        "  openssl req -new -newkey \"rsa:$BITS\" -nodes \\\n",
        "    -keyout \"$KEY\" \\\n",
        "    -x509 -days \"$DAYS\" -sha256 \\\n",
        "    -subj \"$SUBJECT\" \\\n",
        "    -out \"$CRT\" \\\n",
        "    -extensions req_ext -config \"$CNF\"\n",
        "\n",
        "  # Also write CSR for completeness (optional but handy)\n",
        "  openssl req -new -key \"$KEY\" -subj \"$SUBJECT\" \\\n",
        "    -out \"$CSR\" -reqexts req_ext -config \"$CNF\"\n",
        "\n",
        "else\n",
        "  # Generate key + cert (self-signed) without SAN\n",
        "  openssl req -new -newkey \"rsa:$BITS\" -nodes \\\n",
        "    -keyout \"$KEY\" \\\n",
        "    -x509 -days \"$DAYS\" -sha256 \\\n",
        "    -subj \"$SUBJECT\" \\\n",
        "    -out \"$CRT\"\n",
        "\n",
        "  # CSR (optional)\n",
        "  openssl req -new -key \"$KEY\" -subj \"$SUBJECT\" -out \"$CSR\"\n",
        "fi\n",
        "\n",
        "chmod 600 \"$KEY\"\n",
        "\n",
        "echo \"✅ Generated:\"\n",
        "echo \"  Key : $KEY\"\n",
        "echo \"  Cert: $CRT\"\n",
        "echo \"  CSR : $CSR\"\n",
        "if [[ \"$ADD_SAN\" -eq 1 ]]; then\n",
        "  echo \"  Conf: $CNF (SAN enabled)\"\n",
        "fi\n",
        "\n",
        "echo\n",
        "echo \"Inspect cert:\"\n",
        "echo \"  openssl x509 -in \\\"$CRT\\\" -noout -text | sed -n '1,40p'\""
